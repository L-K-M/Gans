<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist merged with the build-setting-generated one
  (GENERATE_INFOPLIST_FILE=YES). It exists only to register a custom URL scheme so the
  Ente passkey flow's `redirect=ente-cli://passkey` activates Gans and brings it forward.
  `ente-cli` is on Ente's accounts redirect allowlist and is not claimed by the Ente CLI
  (a terminal binary registers no URL handler), so adopting it here is safe.
-->
<plist version="1.0">
<dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLName</key>
            <string>ch.lkmc.Gans.passkey</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>ente-cli</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
